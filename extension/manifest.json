{
  "manifest_version": 3,
  "name": "Trigger Track GIF",
  "version": "0.7.7",
  "description": "GIF from current Trigger track: YouTube clip → crop → GIF → catbox link in Trigger chat.",
  "action": {
    "default_title": "Trigger Track GIF",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://triggerfm.online/*",
    "https://*.triggerfm.online/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://catbox.moe/*",
    "https://pomf.lain.la/*",
    "https://pomf2.lain.la/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://triggerfm.online/*",
        "https://*.triggerfm.online/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
